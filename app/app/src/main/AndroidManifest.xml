<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The launcher's lock-screen buttons start scenes directly; only apps signed with the same key may. -->
    <permission
        android:name="io.github.theguywhopaints.glow.permission.SCENE"
        android:protectionLevel="signature" />

    <!-- Talks to the bulb on the local network only. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Wakes the stick (and the TV, over HDMI-CEC) when a scene arrives while it sleeps. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Music sync reads the output mix through Visualizer, which needs these two. Nothing is recorded. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/ic_glow"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Glow"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".CalibrationActivity"
            android:exported="false" />

        <service
            android:name=".GlowService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|mediaPlayback" />

        <!-- Scenes for iPhone Shortcuts / Siri, home network only, token required. -->
        <service
            android:name=".RemoteService"
            android:exported="true"
            android:permission="io.github.theguywhopaints.glow.permission.SCENE"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Home-network scene commands from the owner's phone" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Set up over ADB: bulb address and login hash. DUMP is held by the shell, not by apps. -->
        <receiver
            android:name=".SetupReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.github.theguywhopaints.glow.SETUP" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
